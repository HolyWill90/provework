/target
target-docker/
sp1-done.flag
sp1-exit.txt
**/target/
*.json
!**/job.json
**/program.elf
# the nano job ELF is a sealed zk artifact: the committed receipt is
# bound to its exact bytes, so it is versioned, not rebuilt
!jobs/demo-hash-nano/program.elf
# the V2 demo's SP1-native ELF is committed so CI can exercise the V2
# path (queue, mock proving) without the SP1 toolchain
!jobs/demo-v2/program.elf
sp1-guest/elf/
elf/*
!elf/sp1-guest-emu
# the production worker embeds this guest at compile time (include_bytes!)
# — it must be versioned for CI's sp1-feature check and fresh Linux builds
!elf/sp1-guest-emu
*.key
identities-net/
worker-store*/
p2pc-worker.tar.gz
*.log
*.done
*.dispatching
__pycache__/

# fuzzing + coverage artifacts
fuzz/target/
fuzz/artifacts/
*.profraw
